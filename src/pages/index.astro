---
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import '@fontsource-variable/inter'
import '@fontsource/monoton'
import '@chirag127/oz-tokens-base/contract.css'
import '@chirag127/oz-chrome/styles.css'
import '../styles/theme.css'
import '../styles/generator.css'
import Generator from '../components/Generator.tsx'

const title = 'oriz-name — Free Brand, Startup & Username Name Generator, No Signup'
const desc =
  'Free brand, startup, product, username and repo name generator with vibe controls, availability heuristic and AI taglines. 100% in your browser — no signup.'
const url = 'https://name.oriz.in/'
const ogImage = `${url}screenshots/desktop.png`
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz-name',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url,
  description: desc,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ff2e88" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script>
      import { registerSW } from 'virtual:pwa-register'
      registerSW({ immediate: true })
    </script>
  </head>
  <body>
    <OzToolShell site="name" title="name generator" mainClass="page">
      <section class="hero">
        <p class="hero__kicker neon neon--amber neon--flicker">✦ free · no signup ✦</p>
        <h1 class="hero__title neon">
          Name<span class="neon--cyan"> anything</span>
        </h1>
        <p class="hero__sub">
          Free name generator for brands, startups, products, usernames and repos. Dial a vibe,
          pull the lever, and get fresh names with an availability read and AI taglines — 100% in
          your browser.
        </p>
      </section>

      <Generator client:load />

      <section class="notes">
        <h2 class="notes__h neon neon--violet">How it works</h2>
        <ul class="notes__list">
          <li><b>Deterministic engine</b> — affix, portmanteau, de-vowel, compound + coined techniques, scored for brandability.</li>
          <li><b>Availability</b> is a client-side heuristic (length, dictionary-word, coined spelling). No live WHOIS — every name links out to Namecheap / WHOIS / GitHub / npm / X to verify.</li>
          <li><b>AI names + taglines</b> load the model only on demand, with failover across providers. If AI is down, the core generator still works.</li>
        </ul>
      </section>

      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-name" target="_blank" rel="noopener noreferrer">Source</a>
        <span>100% client-side · no signup · no upload</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>

<style>
  .page {
    display: grid;
    gap: var(--oz-space-12);
  }
  .hero {
    text-align: center;
    display: grid;
    gap: var(--oz-space-3);
    padding: var(--oz-space-8) 0 var(--oz-space-4);
  }
  .hero__kicker {
    font-size: 1rem;
    letter-spacing: 0.3em;
    margin: 0;
  }
  .hero__title {
    font-size: clamp(2.8rem, 9vw, 6rem);
    margin: 0;
  }
  .hero__sub {
    max-width: 48rem;
    margin: 0 auto;
    color: var(--oz-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .notes__h {
    font-size: 1.4rem;
  }
  .notes__list {
    color: var(--oz-muted);
    line-height: 1.8;
    max-width: 60rem;
  }
  .notes__list b {
    color: var(--oz-fg);
  }
</style>
